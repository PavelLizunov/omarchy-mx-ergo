<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MX Ergo</vendor>
  <action id="io.github.pavellizunov.mx-ergo.bluetooth">
    <description>Change the MX Ergo Bluetooth controller profile</description>
    <message>Administrator authorization is required to change Bluetooth controller settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/omarchy-mx-ergo-bluetooth</annotate>
  </action>
</policyconfig>
