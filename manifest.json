{
  "schemaVersion": 1,
  "id": "io.github.pavellizunov.mx-ergo",
  "name": "Logitech MX Ergo",
  "version": "1.0.0",
  "author": "PavelLizunov",
  "license": "MIT",
  "description": "Battery status, connection monitor, and Hyprland pointer controls for Logitech MX Ergo trackball.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Logitech MX Ergo",
    "description": "Battery status, connection monitor, and Hyprland pointer controls for Logitech MX Ergo trackball.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "deviceAddress": "",
      "hyprDeviceName": "logitech-mx-ergo-multi-device-trackball-",
      "hideWhenDisconnected": false,
      "sensitivity": 0.0,
      "accelProfile": "adaptive",
      "naturalScroll": false,
      "locale": "system"
    },
    "schema": [
      {
        "key": "locale",
        "type": "string",
        "label": "Interface language",
        "defaultValue": "system"
      },
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide indicator when trackball is disconnected",
        "defaultValue": false
      },
      {
        "key": "deviceAddress",
        "type": "string",
        "label": "Bluetooth address or HID serial (blank: automatic)",
        "defaultValue": ""
      },
      {
        "key": "hyprDeviceName",
        "type": "string",
        "label": "Hyprland input device name",
        "defaultValue": "logitech-mx-ergo-multi-device-trackball-"
      }
    ]
  }
}
